# Adapter listen configuration
PORT=8081
HOST=0.0.0.0

# Optional bearer token required by this adapter itself
# If set, clients must send: Authorization: Bearer <ADAPTER_TOKEN>
ADAPTER_TOKEN=

# Required upstream URL to query raw flow records.
# Supports placeholders: {clusterId}, {namespace}, {window}
# Example:
# UPSTREAM_URL=http://ipfix-query-service.default.svc.cluster.local:8080/flows?clusterId={clusterId}&namespace={namespace}&window={window}
UPSTREAM_URL=

# Optional bearer token for the upstream endpoint
UPSTREAM_TOKEN=

# Query timeout in milliseconds (default: 8000)
REQUEST_TIMEOUT_MS=8000
