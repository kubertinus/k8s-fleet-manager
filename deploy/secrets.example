# Secrets that are NOT stored in Git. Create them once, before the first deploy.
# (This file has no .yaml extension, so `kubectl apply -f deploy/` skips it.)
#
# Signing key for login tokens: a long random value. Changing it logs everyone out.
#   kubectl -n k8s-fleet-manager create secret generic k8s-fleet-manager-secrets \
#     --from-literal=NEXTAUTH_SECRET="$(openssl rand -hex 32)"
#
# TLS certificate for the ingress host k8s-fleet-manager.diersmann.com (deploy/ingress.yaml):
#   kubectl -n k8s-fleet-manager create secret tls k8s-fleet-manager-tls --cert=fullchain.pem --key=privkey.pem
#   (or let cert-manager issue it)
#
# The database connection (k8s-fleet-manager-postgres-app) is created by CloudNativePG.
